// Gautschi: xalt's LD_PRELOAD breaks older biocontainer images, and Lmod shell
// functions are not inherited by the task shell unless exported.
process.beforeScript = 'module --force purge; module load biocontainers fastp fastqc multiqc; export -f fastp fastqc multiqc'

// RCAC's tool functions launch containers outside Nextflow's container support.
// Copy inputs into every task so containers do not need to follow symlinks to
// data/ or another task's work directory. This also covers FastQC and MultiQC.
process.stageInMode = 'copy'
